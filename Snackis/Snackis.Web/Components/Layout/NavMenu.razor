@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@using Snackis.Core.Entities

@implements IDisposable

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Snackis.Web</a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <a class="nav-link"
               href="https://localhost:7185/api"
               target="_blank"
               rel="noopener noreferrer">
                <span class="bi bi-list-nested-nav-menu"
                      aria-hidden="true"></span>
                API
            </a>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="messages">
                        <span class="bi bi-list-nested-nav-menu"
                              aria-hidden="true"></span>
                        Messages
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu"
                              aria-hidden="true"></span>

                        <span class="text-truncate"
                              title="@displayName">
                            @displayName
                        </span>

                        @if (context.User.IsInRole("Admin"))
                        {
                            <span class="badge bg-warning text-dark ms-2 flex-shrink-0">
                                Admin
                            </span>
                        }
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />

                        <input type="hidden"
                               name="ReturnUrl"
                               value="@currentUrl" />

                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu"
                                  aria-hidden="true"></span>
                            Logout
                        </button>
                    </form>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu"
                              aria-hidden="true"></span>
                        Register
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu"
                              aria-hidden="true"></span>
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/categories">
                        <span class="bi bi-list-nested-nav-menu"
                              aria-hidden="true"></span>
                        Manage Categories
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/topics">
                        <span class="bi bi-list-nested-nav-menu"
                              aria-hidden="true"></span>
                        Manage Topics
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/reports">
                        <span class="bi bi-list-nested-nav-menu"
                              aria-hidden="true"></span>
                        Manage Reports
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private string? currentUrl;

    private string displayName = "Account";

    protected override async Task OnInitializedAsync()
    {
        currentUrl =
            NavigationManager.ToBaseRelativePath(
                NavigationManager.Uri);

        NavigationManager.LocationChanged +=
            OnLocationChanged;

        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            // Read the user with a separate database context.
            using var scope = ScopeFactory.CreateScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<UserManager<AppUser>>();

            var user =
                await userManager.GetUserAsync(
                    authenticationState.User);

            if (!string.IsNullOrWhiteSpace(user?.DisplayName))
            {
                displayName = user.DisplayName.Trim();
            }
        }
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        currentUrl =
            NavigationManager.ToBaseRelativePath(e.Location);

        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -=
            OnLocationChanged;
    }
}